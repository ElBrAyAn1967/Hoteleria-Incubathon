# ── Frontend (apps/web) ──
# Solo esta es pública (va al navegador): la URL de NUESTRO backend, no la de For3s.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Backend (apps/api) ──
PORT=3001
DATABASE_URL=postgresql://user:pass@localhost:5432/hoteleria

# ── For3s (el CEREBRO — CAJA NEGRA, se CONSUME por API) ──
# ⚠️ SEGURIDAD: estas variables NUNCA llevan prefijo NEXT_PUBLIC_. Se usan SOLO
# en el servidor. El navegador del usuario JAMÁS debe ver la URL del túnel ni la
# llave. Si alguna vez ves NEXT_PUBLIC_FOR3S_* → es un ERROR de seguridad.
FOR3S_API_URL=https://<tunel>.trycloudflare.com
FOR3S_API_KEY=for3s_sk_xxx
FOR3S_CLIENT_ID=hoteleria-webapp

# ── Web3 (opcional, si da tiempo) ──
NEXT_PUBLIC_CHAIN_ID=
WEB3_RPC_URL=
